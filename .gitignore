# Secrets & sensitive data
.zsh.secrets
/secrets

# Logs
/logs

# macOS system files
.DS_Store

# macOS custom folder icon file (`Icon` + carriage return)
Icon?

# macOS metadata (AppleDouble, thumbnails, etc.)
__MACOSX/
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Node dependencies (MCP servers etc.)
node_modules/

# Cursor IDE files
.cursorignore
.cursorindexingignore

# Other IDE/tool directories
.specstory
.roomodes

# Vendored upstream source snapshots (large, not tracked)
repos/

# Historical imported archives (large, not tracked)
_archive/

# Generated cache and index files
skills-fetch/scan_cache.tsv
.omo
.omo/
.omc
.omc/
.oma
.oma/

# Stale paths from previous repo states
/.crush
/.cursor
/.roo
/.archive/
/.oh-my-zsh/custom

# Large generated directories
skillz/
apps/
platforms/
